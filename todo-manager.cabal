name:                todo-manager
version:             0.1.0.0
description:         A simple todo manager
category:            CLI
build-type:          Simple
cabal-version:       >=1.10

library
  hs-source-dirs:      src
  exposed-modules:     Task
                     , TaskManager
                     , CLI
  build-depends:       base >=4.7 && <5,
                       directory,
                       time,
                       sqlite-simple,
                       text
  default-language:    Haskell2010

executable todo-manager
  main-is:             Main.hs
  hs-source-dirs:      src
  build-depends:       base >=4.7 && <5,
                       directory,
                       time,
                       todo-manager,
                       sqlite-simple,
                       text
  other-modules:       CLI
                     , Task
                     , TaskManager
  default-language:    Haskell2010

test-suite tests
  type:                exitcode-stdio-1.0
  main-is:             Tests.hs
  hs-source-dirs:      test, src
  build-depends:       base >=4.7 && <5,
                       HUnit,
                       time,
                       todo-manager,
                       sqlite-simple,
                       text,
                       directory
  other-modules:       CLI
                     , Task
                     , TaskManager
  default-language:    Haskell2010